#include <stdio.h>

int removeDuplicates(int* nums, int numsSize) {
  if( numsSize == 0) return 0;
  int i, k = 1;
  for(i = 1; i < numsSize ; i++){
    if(nums[i] != nums[i-1]) {
        nums[k] = nums[i];
        k++;
    }
  }
  return k;    
}

int main(){
    int arr1[6] = {1,2,2,2,3,5};

    int k = removeDuplicates(arr1, 6);

    for(int i = 0; i < k; i++)  printf("%d ", arr1[i]);


}
