#include <stdio.h>

int findDuplicate(int* nums, int numsSize) {
    int i, k = numsSize - 1;
    
    for (i = 0; i < numsSize;){
      if(nums[i] == nums[k] && i != k) return nums[i];
      else if(k == i) {
        i++;
        k = numsSize - 1;
        continue;
      }
      k--;
    }
    return -1;
}

int main(){
  int nums[] = {3,1,3,4,2};
  int size = sizeof(nums) / sizeof(nums[0]);
  int duplicate = findDuplicate(nums, size);
  printf("%d\n", duplicate);
}
