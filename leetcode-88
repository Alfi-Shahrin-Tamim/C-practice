#include <stdio.h>

void merge(int* nums1, int nums1Size, int m, int* nums2, int nums2Size, int n) {
    int i,j, k;
    for (i = m - 1, j = n - 1, k = m + n - 1; i >= 0 && j >= 0;){
        if(nums1[i] > nums2[j]){
            nums1[k] = nums1[i];
            i--;
        }
        else{
            nums1[k] = nums2[j];
            j--;
        }
        k--;
    }
    while(j >= 0){
         nums1[k--] = nums2[j--];
    }     
}

int main(){
    int m, n, i, j;
    printf("Number of elements for first array: ");
    scanf("%d", &m);    
    printf("Size for 2nd array: ");
    scanf("%d", &n);
    int nums1[m+n], nums2[n];
    for(i = 0; i < m; i++){
        printf("For first array, Value at index %d: ", i);
        scanf("%d", &nums1[i]);
    }
    for(j = 0; j < n; j++){
        printf("For second array, Value at index %d: ", j);
        scanf("%d", &nums2[j]);
    }

    merge( nums1, m + n, m, nums2, n, n);

    printf("[");
    for(i = 0; i < m + n; i ++){
        if(i == m + n -1) printf("%d", nums1[i]);
        else printf("%d, ", nums1[i]);
    }
    printf("]");



}
