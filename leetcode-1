#include <stdio.h>

void moveZeroes(int* nums, int numsSize) {
     int i, k = 0;
     for (i = 1; i < numsSize ; i++){
        if(nums[k] != 0) k++;
        else{
          if(nums[i] != 0){
            nums[k] = nums[i];
            nums[i] = 0;
            k++;
          }
        }
     }     
}

int main(){
    int arr[] = {0,0,1,0,3,12};
    int size = sizeof(arr) / sizeof(arr[0]);
    moveZeroes(arr, size);
    for(int i = 0; i < size; i++) printf("%d ", arr[i]);
}
