#include <stdio.h>

void moveZeroes(int* nums, int numsSize) {
     int i, k;
     for (i = 0; i < numsSize; i++){
        k = i;
        if(nums[i] == 0){
          while(nums[k] == 0 && k < numsSize - 1) k++;
          if( k > 0){
          nums[i] = nums[k];
          nums[k] = 0;
          }
        }
     }
}

int main(){
    int arr[] = {1,0,1};
    int size = sizeof(arr) / sizeof(arr[0]);
    moveZeroes(arr, size);
    for(int i = 0; i < size; i++) printf("%d ", arr[i]);
}
